{
  "name": "gtm-test",
  "version": "0.0.0-semantically-released",
  "description": "template repo for integration tests",
  "main": "index.js",
  "scripts": {
    "build": "npm run lint && rimraf dist/ && babel ./src --out-dir dist/src --copy-files && babel ./test --out-dir dist/test --copy-files && babel ./index.js --out-dir dist/ --copy-files",
    "commit": "./node_modules/.bin/git-cz",
    "lint": "node ./node_modules/.bin/eslint ./src ./test --fix --ext=.js --ignore-pattern src/agent/static/ --ignore-pattern node_modules/ --ignore-pattern dist/ --ignore-pattern coverage/ --quiet",
    "test": "npm run build && cross-env NODE_ENV=test nyc ./node_modules/.bin/mocha --timeout 10000 --require @babel/register \"./dist/test/**/*.spec.js\"",
    "agent": "node ./dist/index.js",
    "prepare": "npm run snyk-protect",
    "snyk-protect": "snyk-protect"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyvern8/gtm-test.git"
  },
  "author": "Andrew Vaughan <andrewv@smartcreations.com.au> (https://halt.sh)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wyvern8/gtm-test/issues"
  },
  "homepage": "https://github.com/wyvern8/gtm-test#readme",
  "devDependencies": {
    "@babel/cli": "^7.25.0",
    "@babel/core": "^7.25.0",
    "@babel/plugin-transform-runtime": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/register": "^7.25.0",
    "babel-loader": "^9.1.3",
    "babel-plugin-istanbul": "^6.1.1",
    "chai": "^4.1.2",
    "commitizen": "^4.3.1",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^4.0.0",
    "eslint": "^4.12.0",
    "eslint-config-prettier": "2.9.0",
    "eslint-plugin-prettier": "2.4.0",
    "firstline": "^1.2.1",
    "format-json": "^1.0.3",
    "mocha": "^10.7.0",
    "nyc": "^15.1.0",
    "prettier": "1.9.2",
    "rimraf": "^3.0.2",
    "sass": "^1.77.0",
    "sass-loader": "^14.2.1",
    "semantic-release": "^8.2.0",
    "serverless": "^3.39.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-webpack": "^5.14.0",
    "sinon": "^4.1.2",
    "sqs-producer": "^1.6.2",
    "supertest": "^3.0.0"
  },
  "engines": {
    "node": ">=8.4.0"
  },
  "nyc": {
    "require": [
      "@babel/register"
    ],
    "reporter": [
      "lcov",
      "text"
    ],
    "sourceMap": false,
    "instrument": false
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "github-task-manager": "^5.0.3",
    "bunyan": "^1.8.13",
    "bunyan-cloudwatch": "^2.2.0",
    "bunyan-format": "^0.2.1",
    "dockerode": "^4.0.0",
    "express": "^4.21.2",
    "express-nunjucks": "^2.2.5",
    "express-sse": "^0.4.1",
    "github": "^14.0.0",
    "globule": "^1.3.4",
    "highlight.js": "^10.4.1",
    "jenkins": "^0.20.1",
    "nunjucks": "^3.2.4",
    "proxy-agent": "^6.3.0",
    "request": "^2.88.2",
    "request-promise-native": "^1.0.9",
    "require-dir": "^0.3.2",
    "safe-json-stringify": "^1.0.4",
    "smoketail": "^0.1.0",
    "sqs-consumer": "^5.5.0",
    "systemjs": "^0.20.19",
    "teamcity-rest-api": "0.0.8",
    "travis-ci": "^2.2.0",
    "uuid": "^3.1.0",
    "webpack": "^5.94.0",
    "@snyk/protect": "latest",
    "@babel/runtime": "^7.25.0",
    "core-js": "^3.38.0"
  },
  "snyk": true,
  "overrides": {
    "decompress": "^4.2.1",
    "handlebars": "^4.7.10",
    "proxy-addr": "^2.0.8",
    "zlib": "npm:node-noop@^1.0.0",
    "lodash": "^4.17.21",
    "minimist": "^1.2.8",
    "mkdirp": "^1.0.4",
    "deep-extend": "^0.6.0",
    "netmask": "^2.0.2",
    "form-data": "^4.0.0"
  }
}
